services:
  3x-ui:
    image: {{ xui_image }}
    container_name: {{ xui_container_name }}

    restart: {{ xui_restart_policy }}

    network_mode: host

    environment:
      XRAY_VMESS_AEAD_FORCED: "false"
      XUI_ENABLE_FAIL2BAN: "true"

    volumes:
      - {{ xui_db_dir }}:/etc/x-ui/
      - {{ xui_cert_dir }}:/root/cert/
      - {{ xui_acme_dir }}:/root/acme/

    cap_add:
      - NET_ADMIN
      - NET_RAW
